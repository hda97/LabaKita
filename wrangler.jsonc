// Konfigurasi Cloudflare Workers (static assets). Situs ini statis: Worker hanya
// menyajikan isi folder dist/ hasil `npm run build`. Lihat docs/DEPLOY.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "labakita",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
