---
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<section class="faq" aria-labelledby="faq-title">
  <h2 id="faq-title">Pertanyaan yang sering diajukan</h2>
  {
    items.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))
  }
</section>
