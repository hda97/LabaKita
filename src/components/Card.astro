---
// Kartu artikel/kalkulator. Seluruh kartu bisa diklik; sorotan mengikuti kursor (lihat scripts di BaseLayout).
interface Props {
  slug: string;
  title: string;
  text?: string;
  tag?: string;
  heading?: 'h2' | 'h3';
  attrs?: Record<string, string>;
}
const { slug, title, text, tag, heading = 'h3', attrs = {} } = Astro.props;
const H = heading;
const aksi = slug.startsWith('kalkulator-') ? 'Hitung sekarang' : 'Baca panduan';
---

<li class="card" data-slug={slug} data-reveal {...attrs}>
  {tag && <span class="card-tag">{tag}</span>}
  <H class="card-title"><a href={`/${slug}/`}>{title}</a></H>
  {text && <p>{text}</p>}
  <span class="card-foot">
    <span>{aksi} <span class="arrow" aria-hidden="true">→</span></span>
    <span class="read-flag" hidden>✓ Sudah dibaca</span>
  </span>
</li>
