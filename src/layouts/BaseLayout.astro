---
import site from '../../site.config.mjs';
import '../styles/global.css';
import Newsletter from '../components/Newsletter.astro';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  schema?: object[];
  noindex?: boolean;
  newsletter?: boolean;
  articleSlug?: string;
}

const { title, description, type = 'website', schema = [], noindex = false, newsletter = true, articleSlug } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
const path = Astro.url.pathname;
// Gambar pratinjau: public/og/<slug>.png bila ada (dibuat scripts/buat-gambar-sosial.cjs), selain itu default.
import { existsSync } from 'node:fs';
const ogSlug = path === '/' ? 'default' : path.replace(/^\/|\/$/g, '');
const ogImage = new URL(`/og/${existsSync(`public/og/${ogSlug}.png`) ? ogSlug : 'default'}.png`, site.url).href;

const menu = [
  { href: '/kalkulator/', label: 'Kalkulator' },
  { href: '/panduan/', label: 'Panduan' },
  { href: '/modal-keuangan/', label: 'Modal & Keuangan' },
  { href: '/hobi-jadi-usaha/', label: 'Hobi Jadi Usaha' },
];

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  email: site.email,
};
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || !site.indexable) && <meta name="robots" content={site.indexable ? 'noindex, follow' : 'noindex, nofollow'} />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#fbfbf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111312" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Pasang tema dan ukuran teks sebelum halaman tampil, supaya tidak berkedip.
      (function () {
        var d = document.documentElement;
        try {
          var t = localStorage.getItem('lk-theme');
          if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          d.dataset.theme = t;
          var fs = parseFloat(localStorage.getItem('lk-fs'));
          if (fs >= 0.9 && fs <= 1.3) d.style.setProperty('--fs', String(fs));
        } catch (e) {
          d.dataset.theme = 'light';
        }
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500&family=IBM+Plex+Sans:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    {
      site.gaMeasurementId && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.gaMeasurementId}`} />
          <script is:inline define:vars={{ id: site.gaMeasurementId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', id);
          </script>
        </>
      )
    }
    {
      site.adsenseClient && (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.adsenseClient}`}
          crossorigin="anonymous"
        />
      )
    }
    {[organization, ...schema].map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body data-artikel={articleSlug}>
    <a class="skip" href="#isi">Langsung ke isi</a>
    <div class="progress-bar" aria-hidden="true"><span></span></div>
    <header class="site-header">
      <div class="wrap-wide">
        <div class="header-row">
          <a class="logo" href="/">{site.name}</a>
          <div class="header-tools">
            <form class="search" action="/cari/" method="get" role="search">
              <label for="q-header" class="skip">Cari</label>
              <input id="q-header" type="search" name="q" placeholder="Cari kalkulator/panduan" />
              <button type="submit">Cari</button>
            </form>
            <button class="tool-btn" type="button" data-fs="-1" aria-label="Perkecil teks">A−</button>
            <button class="tool-btn" type="button" data-fs="1" aria-label="Perbesar teks">A+</button>
            <button class="tool-btn" type="button" data-theme-toggle aria-label="Ganti mode gelap atau terang">Gelap</button>
          </div>
        </div>
        <nav aria-label="Menu utama">
          <ul class="nav">
            {
              menu.map((m) => (
                <li>
                  <a href={m.href} aria-current={path.startsWith(m.href) ? 'page' : undefined}>
                    {m.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>
    <main id="isi">
      <slot name="wide" />
      <div class="wrap">
        <slot />
        {newsletter && <Newsletter />}
      </div>
    </main>
    <footer class="site-footer">
      <div class="wrap-wide">
        <p class="footer-brand">{site.name}: kalkulator dan panduan untuk usaha kecil</p>
        <ul>
          <li><a href="/tentang/">Tentang Kami</a></li>
          <li><a href="/kontak/">Kontak</a></li>
          <li><a href="/kebijakan-privasi/">Kebijakan Privasi</a></li>
          <li><a href="/disclaimer/">Disclaimer</a></li>
          <li><a href="/syarat-ketentuan/">Syarat &amp; Ketentuan</a></li>
        </ul>
        <ul>
          {menu.map((m) => <li><a href={m.href}>{m.label}</a></li>)}
        </ul>
        <p>
          © {new Date().getFullYear()} {site.name}. Informasi di situs ini bersifat umum dan bukan nasihat keuangan, pajak, atau hukum. Hasil kalkulator adalah perkiraan.
        </p>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var d = document.documentElement;
        var save = function (k, v) {
          try {
            localStorage.setItem(k, v);
          } catch (e) {}
        };
        var toggle = document.querySelector('[data-theme-toggle]');
        var label = function () {
          toggle.textContent = d.dataset.theme === 'dark' ? 'Terang' : 'Gelap';
          toggle.setAttribute('aria-pressed', d.dataset.theme === 'dark' ? 'true' : 'false');
        };
        label();
        toggle.addEventListener('click', function () {
          d.dataset.theme = d.dataset.theme === 'dark' ? 'light' : 'dark';
          save('lk-theme', d.dataset.theme);
          label();
        });
        document.querySelectorAll('[data-fs]').forEach(function (b) {
          b.addEventListener('click', function () {
            var cur = parseFloat(getComputedStyle(d).getPropertyValue('--fs')) || 1;
            var next = Math.min(1.3, Math.max(0.9, Math.round((cur + Number(b.dataset.fs) * 0.1) * 10) / 10));
            d.style.setProperty('--fs', String(next));
            save('lk-fs', String(next));
          });
        });
        // Tandai artikel yang sudah dibaca (disimpan hanya di perangkat ini).
        var read = [];
        try {
          read = JSON.parse(localStorage.getItem('lk-dibaca') || '[]');
        } catch (e) {}
        var current = document.body.dataset.artikel;
        if (current && read.indexOf(current) < 0) {
          read.push(current);
          save('lk-dibaca', JSON.stringify(read));
        }
        document.querySelectorAll('.card[data-slug]').forEach(function (c) {
          var f = c.querySelector('.read-flag');
          if (f && read.indexOf(c.dataset.slug) >= 0) f.hidden = false;
        });
        var bar = document.querySelector('.progress-bar span');
        var onScroll = function () {
          var max = d.scrollHeight - innerHeight;
          bar.style.width = (max > 0 ? Math.min(100, (scrollY / max) * 100) : 0) + '%';
        };
        addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      })();
    </script>
  </body>
</html>
