{
  "name": "labakita",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node -e \"require('fs').rmSync('node_modules/.astro',{recursive:true,force:true})\" && astro build",
    "preview": "astro preview",
    "check": "node scripts/check-site.mjs",
    "build:prod": "SITE_INDEXABLE=true npm run build",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "astro": "7.3.8"
  }
}
